        "template": "<io:var id=\"{id}\" name=\"{name}\">\n  <ext:data><![CDATA[{ext_json}]]></ext:data>\n  <bpmn2:incoming>{incoming}</bpmn2:incoming>\n  <bpmn2:outgoing>{outgoing}</bpmn2:outgoing>\n</io:var>",
        "diagram_template": "<bpmndi:BPMNShape id=\"{id}_di\" bpmnElement=\"{id}\">\n  <dc:Bounds x=\"{x}\" y=\"{y}\" width=\"200\" height=\"60\"/>\n</bpmndi:BPMNShape>",
        "ext_data_schema": {
          "type": "object",
          "required": ["subTitle", "showDetail", "data"],
          "properties": {
            "subTitle": { "type": "string", "default": "" },
            "showDetail": { "type": "boolean", "default": true },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "targetValue", "row"],
                "properties": {
                  "name": { "type": "string", "description": "变量名 $(XXX)" },
                  "type": { "type": "integer", "description": "1=模拟量, 3=数字量" },
                  "targetValue": { "type": "string", "description": "写入值或引用" },
                  "row": { "type": ["integer", "string"] }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },

    {
      "name": "数值计算",
      "category": "操作执行",
      "purpose": "按表达式进行计算并将结果赋值给目标变量/参数。",
      "usage_scenario": "需要执行数学运算并记录结果的场景。",
