                  "desc": { "type": "string", "default": "" },
                  "targetVar": { "type": "string", "description": "目标变量 $(XXX)" },
                  "express": { "type": "string", "description": "计算表达式" }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },

    {
