        "diagram_template": "<bpmndi:BPMNShape id=\"{id}_di\" bpmnElement=\"{id}\">\n  <dc:Bounds x=\"{x}\" y=\"{y}\" width=\"200\" height=\"60\"/>\n</bpmndi:BPMNShape>",
        "ext_data_schema": null
      }
    }

  ],

  "sequenceFlow_template": {
    "description": "连接任意两个元件的标准连线，放在 <bpmn2:process> 内",
    "selection_rules": {
      "description": "连线变体选择规则（强制）：根据源元件类型选择对应的连线变体",
      "rules": [
        {
          "source_element": "flow:and",
          "outgoing": "situation_yes → 条件成立分支",
          "incoming": "situation_no → 条件不成立分支",
          "note": "条件与元件：条件成立走 situation_yes，条件不成立走 situation_no"
        },
        {
          "source_element": "flow:or",
          "outgoing": "situation_yes → 条件成立分支",
          "incoming": "situation_no → 条件不成立分支",
          "note": "条件或元件：条件成立走 situation_yes，条件不成立走 situation_no"
        },
        {
          "source_element": "timer:cond",
          "outgoing": "situation_yes → 条件成立分支",
          "incoming": "situation_no → 条件不成立分支",
          "note": "计时器判断元件：条件成立走 situation_yes，条件不成立走 situation_no"
        },
        {
          "source_element": "flow:branch",
          "outgoing": "branch_option → 择一分支选项连线",
          "note": "择一分支元件：每个分支使用 branch_option，situation 值对应分支索引（0, 1, 2...）"
        },
        {
          "source_element": "其他所有元件（flow:start, flow:end, io:*, timer:start, timer:stop, timer:reset, msg:*, timer:wait 等）",
          "outgoing": "plain",
          "incoming": "plain",
          "note": "非条件判断类元件统一使用 plain 普通连线"
        }
      ]
    },
    "variants": {
      "plain": {
        "description": "普通连线",
        "xml": "<bpmn2:sequenceFlow id=\"{flow_id}\" sourceRef=\"{source}\" targetRef=\"{target}\">\n  <ext:data><![CDATA[{\"lineType\":1}]]></ext:data>\n</bpmn2:sequenceFlow>"
      },
      "situation_yes": {
        "description": "条件成立分支（是），用于 flow:and/flow:or/timer:cond 的 outgoing 连线",
        "xml": "<bpmn2:sequenceFlow id=\"{flow_id}\" name=\"条件成立\" sourceRef=\"{source}\" targetRef=\"{target}\">\n  <ext:data><![CDATA[{\"situation\":\"yes\"}]]></ext:data>\n</bpmn2:sequenceFlow>"
      },
      "situation_no": {
        "description": "条件不成立分支（否），用于 flow:and/flow:or/timer:cond 的 outgoing 连线",
        "xml": "<bpmn2:sequenceFlow id=\"{flow_id}\" name=\"条件不成立\" sourceRef=\"{source}\" targetRef=\"{target}\">\n  <ext:data><![CDATA[{\"situation\":\"no\"}]]></ext:data>\n</bpmn2:sequenceFlow>"
      },
      "branch_option": {
        "description": "择一分支的选项连线，用于 flow:branch 的 outgoing 连线",
        "xml": "<bpmn2:sequenceFlow id=\"{flow_id}\" name=\"{选项名}\" sourceRef=\"{source}\" targetRef=\"{target}\">\n  <ext:data><![CDATA[{\"situation\":\"{0|1|2...}\"}]]></ext:data>\n</bpmn2:sequenceFlow>"
      }
    },
    "diagram_xml": "<bpmndi:BPMNEdge id=\"{flow_id}_di\" bpmnElement=\"{flow_id}\">\n  <di:waypoint x=\"{x1}\" y=\"{y1}\"/>\n  <di:waypoint x=\"{x2}\" y=\"{y2}\"/>\n  <!-- 有 name 时加 BPMNLabel -->\n</bpmndi:BPMNEdge>"
  }
}
