        "status": "confirmed",
        "element": "io:calc",
        "id_pattern": "Activity_{7位随机字母数字}",
        "required_attributes": ["id", "name"],
        "optional_attributes": [],
        "required_children": [
          { "tag": "ext:data", "type": "cdata_json" },
          { "tag": "bpmn2:incoming", "type": "text" },
          { "tag": "bpmn2:outgoing", "type": "text" }
        ],
        "optional_children": [],
        "diagram": { "element": "bpmndi:BPMNShape", "bounds": { "width": 200, "height": 60 } },
        "template": "<io:calc id=\"{id}\" name=\"{name}\">\n  <ext:data><![CDATA[{ext_json}]]></ext:data>\n  <bpmn2:incoming>{incoming}</bpmn2:incoming>\n  <bpmn2:outgoing>{outgoing}</bpmn2:outgoing>\n</io:calc>",
        "diagram_template": "<bpmndi:BPMNShape id=\"{id}_di\" bpmnElement=\"{id}\">\n  <dc:Bounds x=\"{x}\" y=\"{y}\" width=\"200\" height=\"60\"/>\n</bpmndi:BPMNShape>",
        "ext_data_schema": {
          "type": "object",
          "required": ["subTitle", "version", "showDetail", "data"],
          "properties": {
